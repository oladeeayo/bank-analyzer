generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ───────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  password      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  banks               Bank[]
  categories          Category[]
  classificationRules ClassificationRule[]
  manualOverrides     ManualOverride[]
  budgets             Budget[]
  goals               Goal[]

  sessions Session[]
  accounts Account[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Banks ──────────────────────────────────────────────

model Bank {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName       String
  accountName    String?
  accountNumber  String?
  nickname       String?
  openingBalance Float    @default(0)
  currency       String   @default("NGN")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  statements   Statement[]
  transactions Transaction[]

  @@unique([userId, bankName, accountNumber])
}

// ─── Statements ─────────────────────────────────────────

model Statement {
  id               String   @id @default(cuid())
  bankId           String
  bank             Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  month            Int
  year             Int
  filename         String
  fileType         String
  parserVersion    Int      @default(1)
  status           String   @default("uploaded")
  transactionCount Int      @default(0)
  uploadedAt       DateTime @default(now())

  transactions       Transaction[]
  stagedTransactions StagedTransaction[]

  @@unique([bankId, month, year])
}

// ─── Categories ─────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  icon      String   @default("📁")
  color     String   @default("#6B7280")
  sortOrder Int      @default(0)
  isSystem  Boolean  @default(false)
  parentId  String?
  createdAt DateTime @default(now())

  parent              Category?            @relation("CategoryTree", fields: [parentId], references: [id])
  children            Category[]           @relation("CategoryTree")
  transactions        Transaction[]
  budgets             Budget[]
  classificationRules ClassificationRule[]
  manualOverrides     ManualOverride[]

  @@unique([parentId, name])
}

// ─── Merchants ──────────────────────────────────────────

model Merchant {
  id             String   @id @default(cuid())
  normalizedName String   @unique
  displayName    String
  icon           String   @default("🏪")
  color          String   @default("#6B7280")
  createdAt      DateTime @default(now())

  transactions        Transaction[]
  manualOverrides     ManualOverride[]
  classificationRules ClassificationRule[]

  recurringTransactions RecurringTransaction[]
}

// ─── Transactions ───────────────────────────────────────

model Transaction {
  id                    String    @id @default(cuid())
  statementId           String
  statement             Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  bankId                String
  bank                  Bank      @relation(fields: [bankId], references: [id], onDelete: Cascade)
  date                  DateTime
  description           String
  normalizedDescription String?
  memo                  String?
  institution           String?
  accountOrPhone        String?
  channelTag            String?   // POS_AGENT | DIRECT_TRANSFER | UTILITY | SYSTEM_CHARGE | GATEWAY
  merchantId            String?
  merchant              Merchant? @relation(fields: [merchantId], references: [id])
  categoryId            String?
  category              Category? @relation(fields: [categoryId], references: [id])
  amount                Float
  type                  String // "debit" | "credit"
  balance               Float?
  reference             String?
  narration             String?
  isTransfer            Boolean   @default(false)
  isSelfTransfer        Boolean   @default(false)
  transferToBankId      String?
  isRecurring           Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([date])
  @@index([bankId])
  @@index([merchantId])
  @@index([categoryId])
  @@index([type])
  @@index([channelTag])
  @@index([institution])
  @@index([bankId, reference])
  @@index([bankId, amount, date, description(100)])
}

// ─── Upload Log (idempotency guard) ─────────────────────

model UploadLog {
  id        String   @id @default(cuid())
  userId    String
  bankId    String
  fileHash  String
  filename  String
  fileSize  Int
  status    String   @default("completed") // completed | failed | duplicate
  createdAt DateTime @default(now())

  @@unique([bankId, fileHash])
  @@index([userId])
}

// ─── Staged Transactions (Import Review) ────────────────

model StagedTransaction {
  id                  String    @id @default(cuid())
  statementId         String
  statement           Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  date                DateTime
  description         String
  amount              Float
  type                String
  balance             Float?
  reference           String?
  narration           String?
  status              String    @default("pending") // pending | accepted | rejected | edited
  suggestedMerchantId String?
  suggestedCategoryId String?
  editedMerchantId    String?
  editedCategoryId    String?
  createdAt           DateTime  @default(now())

  @@index([statementId])
}

// ─── Classification Rules ───────────────────────────────

model ClassificationRule {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  type       String // "contains" | "equals" | "regex"
  pattern    String
  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id])
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  priority   Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ─── Manual Overrides ───────────────────────────────────

model ManualOverride {
  id               String    @id @default(cuid())
  userId           String
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description      String
  normalizedKey    String?
  merchantId       String?
  merchant         Merchant? @relation(fields: [merchantId], references: [id])
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id])
  createdAt        DateTime  @default(now())

  @@unique([userId, description])
  @@index([userId, normalizedKey])
}

// ─── Recurring Transactions ─────────────────────────────

model RecurringTransaction {
  id               String    @id @default(cuid())
  merchantId       String
  merchant         Merchant  @relation(fields: [merchantId], references: [id])
  frequency        String // "daily" | "weekly" | "monthly" | "yearly"
  avgAmount        Float
  nextExpectedDate DateTime?
  lastSeenDate     DateTime
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ─── Budgets ────────────────────────────────────────────

model Budget {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  month      Int
  year       Int
  limit      Float
  createdAt  DateTime @default(now())

  @@unique([userId, categoryId, month, year])
}

// ─── Goals ──────────────────────────────────────────────

model Goal {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  deadline      DateTime?
  icon          String    @default("🎯")
  isCompleted   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
